# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Payment Token (получить у платежной системы)
PAYMENT_TOKEN=your_payment_token_here

# Owner ID (ваш Telegram ID, можно узнать у @userinfobot)
OWNER_ID=123456789

# Admin IDs (ID администраторов через запятую)
ADMIN_IDS=123456789,987654321

# Database URL (по умолчанию SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Data parces
GARMIN_EMAIL=your_garmin_email
GARMIN_PASSWORD=your_garmin_password